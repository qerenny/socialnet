<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".profile.ProfileFragment">

    <TextView
        android:id="@+id/profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <!-- Name -->
    <TextView
        android:id="@+id/profile_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/profile_name_label"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profile_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName"
        android:hint="@string/profile_name_label"
        android:enabled="false"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    <!-- Bio -->
    <TextView
        android:id="@+id/profile_bio_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/profile_bio_label"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profile_bio_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:hint="@string/profile_bio_label"
        android:enabled="false"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    <!-- Status Roulette -->
    <TextView
        android:id="@+id/profile_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/profile_status_label"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/profile_status_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:minHeight="48dp" />

    <!-- Actions -->
    <Button
        android:id="@+id/btn_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/profile_edit_button" />

    <Button
        android:id="@+id/btn_save_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/profile_save_button"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
