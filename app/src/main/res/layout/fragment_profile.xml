<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".profile.ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Avatar Placeholder -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/profile_avatar_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_avatar_background"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/profile_avatar_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="ИИ" />
            </FrameLayout>

            <!-- Name -->
            <EditText
                android:id="@+id/profile_name_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:hint="@string/profile_name_label"
                android:enabled="false"
                android:gravity="center"
                android:textAlignment="center"
                android:background="@android:color/transparent"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Иван Иванов"/>

            <!-- Status -->
            <Spinner
                android:id="@+id/profile_status_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:enabled="false"
                android:gravity="center"
                android:textAlignment="center"
                android:minHeight="48dp"
                android:background="@android:color/transparent"  />

            <!-- Info Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">

                <!-- Bio -->
                <EditText
                    android:id="@+id/profile_bio_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:hint="Тут будет твое описание"
                    android:enabled="false"
                    android:background="@android:color/transparent"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="My mother told me..."/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_bio_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:alpha="0.7"/>

                <!-- Username -->
                <EditText
                    android:id="@+id/profile_username_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:inputType="text"
                    android:enabled="false"
                    android:background="@android:color/transparent"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="#7130E7"
                    tools:text="@mothername"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_username_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:alpha="0.7"/>

                <!-- Birthday -->
                <TextView
                    android:id="@+id/profile_birthday_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:hint="Тут будет твой день рождения"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_birthday_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:alpha="0.7"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="@string/action_edit_profile" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
